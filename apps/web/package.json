{
  "name": "@scout/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-maplibre-worker.mjs && next dev --hostname 127.0.0.1",
    "build": "node scripts/copy-maplibre-worker.mjs && next build",
    "build:static": "node scripts/copy-maplibre-worker.mjs && STATIC_EXPORT=1 next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@scout/analysis": "workspace:*",
    "@scout/application": "workspace:*",
    "@scout/contracts": "workspace:*",
    "@scout/ui": "workspace:*",
    "@tailwindcss/postcss": "^4.2.0",
    "maplibre-gl": "^6.9.0",
    "next": "^16.4.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.2.0"
  },
  "devDependencies": {
    "@scout/testing": "workspace:*"
  }
}
