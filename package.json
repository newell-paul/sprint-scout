{
  "name": "sprint-scout",
  "version": "0.9.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @scout/web dev",
    "lint": "eslint . && prettier --check .",
    "lint:md": "markdownlint-cli2",
    "spell": "cspell --no-progress \"**\"",
    "boundaries": "depcruise apps packages e2e --config .dependency-cruiser.cjs",
    "knip": "knip",
    "typecheck": "tsc --noEmit && pnpm --filter @scout/web typecheck",
    "typecheck:coverage": "NODE_OPTIONS=--max-old-space-size=12288 type-coverage",
    "check:static": "pnpm lint && pnpm lint:md && pnpm spell && pnpm boundaries && pnpm knip && pnpm typecheck && pnpm typecheck:coverage",
    "verify": "pnpm check:static && pnpm test && pnpm test:component && pnpm test:e2e",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:component": "vitest run --project browser",
    "dashboard": "tsx packages/testing/src/dashboard.cli.ts --out reports/dashboard --history reports/dashboard/history.json --playwright reports/e2e/report.json --unit reports/unit/report.json --component reports/component/report.json --coverage coverage/coverage-summary.json --mutation reports/mutation/mutation.json --type-coverage reports/type-coverage.json --lighthouse .lighthouseci --size reports/size.json --evals reports/evals/results.json --runs reports/github/runs.json --pulls reports/github/pulls.json --intents intent --open-intents reports/github/open-intents.json --reviews reports/review/reviews.json --bands packages/testing/bands.yaml",
    "test:changed": "vitest run --project unit --changed",
    "test:mutation": "stryker run",
    "test:contract:drift": "tsx packages/testing/src/drift.ts",
    "test:e2e": "playwright test",
    "test:visual": "VISUAL=1 pnpm test:e2e --grep @visual",
    "test:visual:update": "bash scripts/visual-baselines.sh",
    "build:static": "NEXT_PUBLIC_BASE_PATH=/sprint-scout pnpm --filter @scout/web build:static",
    "test:smoke:static": "playwright test --config playwright.static.config.ts",
    "test:lighthouse": "tsx packages/testing/src/lighthouse.cli.ts",
    "test:size": "size-limit",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "check:deploy": "pnpm build:static && pnpm test:smoke:static && pnpm test:size && pnpm test:lighthouse",
    "build": "pnpm typecheck && pnpm --filter @scout/web build",
    "evals": "node scripts/run-evals.mjs",
    "review:resolve": "node scripts/resolve-thread.mjs",
    "baselines:commit": "tsx packages/testing/src/baselines.cli.ts",
    "release:bump": "tsx packages/testing/src/release-bump.cli.ts",
    "release:notes": "tsx packages/testing/src/release-notes.cli.ts",
    "review:tally": "tsx packages/testing/src/review.cli.ts",
    "triage": "tsx packages/testing/src/triage.cli.ts",
    "spec:draft": "tsx packages/testing/src/spec-draft.cli.ts",
    "band:issue": "tsx packages/testing/src/band-issue.cli.ts",
    "check:intents": "tsx packages/testing/src/intents.cli.ts",
    "banner": "node scripts/render-banner.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint-react/eslint-plugin": "^5.28.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@scout/testing": "workspace:*",
    "@size-limit/file": "14.2.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "4.1.12",
    "@vitest/coverage-v8": "4.1.12",
    "@vitest/eslint-plugin": "^1.6.27",
    "axe-core": "^4.14.0",
    "cspell": "^10.4.0",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.13.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-playwright": "^2.12.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unicorn": "^74.0.0",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "knip": "^6.42.1",
    "markdownlint-cli2": "^0.23.3",
    "playwright": "1.64.1",
    "prettier": "^3.9.10",
    "size-limit": "14.2.0",
    "tsx": "^4.23.15",
    "type-coverage": "^2.30.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.12",
    "vitest-browser-react": "^2.3.0",
    "yaml": "2.9.1"
  },
  "typeCoverage": {
    "atLeast": 99.5,
    "strict": true,
    "ignoreNonNullAssertion": true,
    "project": "tsconfig.json",
    "ignoreFiles": [
      "**/*.test.ts",
      "**/*.test.tsx",
      "apps/web/out/**",
      "**/.next/**"
    ]
  },
  "size-limit": [
    {
      "name": "planner client JavaScript, gzip",
      "path": "apps/web/out/_next/static/chunks/*.js",
      "limit": "550 kB"
    }
  ]
}
