{
  "ci": {
    "collect": {
      "startServerCommand": "NEXT_PUBLIC_BASE_PATH=/sprint-scout node scripts/serve-static.mjs apps/web/out",
      "startServerReadyPattern": "static export at",
      "url": ["http://127.0.0.1:4173/sprint-scout/"],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "budgetPath": "./budgets.json",
        "chromeFlags": "--no-sandbox --disable-gpu"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2500
          }
        ],
        "total-blocking-time": [
          "error",
          {
            "maxNumericValue": 300
          }
        ],
        "performance-budget": "error"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
